            "libs/tariff-ui/**",
            "components/manager-homeowner/src/public/protos/homeowner.proto",
            "components/manager-analysis/src/public/protos/manager_analysis.proto",
            "components/manager-siteconfiguration/src/public/site-management.proto",
            "components/manager-siteconfiguration/src/public/alarm-subscriptions.proto",
            "components/manager-vppOps/src/public/vpp_ops.proto",
            "components/manager-feed/src/public/feed.proto",
            "components/manager-vppOps/src/resolver/types.ts",
            "libs/contracts/**",
            "libs/site-online/**",
            "libs/ra-workflow-client/**",
            "docs/vpp/design/ops-center-handoff/**"
          ],
          "tags": [
            "v[0-9]+.[0-9]+.[0-9]+"
          ]
        },
        "pull_request": {
          "types": [
            "opened",
            "synchronize",
            "reopened",
            "ready_for_review"
          ],
          "branches": [
            "main"
          ],
          "paths": [
            "components/web-fmp/**",
            "!components/web-fmp/docs/**",
            "!components/web-fmp/obs/**",
            "!components/web-fmp/infra/**",
            "libs/vpp-explorer-core/**",
            "libs/tariff-ui/**",
            "components/manager-homeowner/src/public/protos/homeowner.proto",
            "components/manager-analysis/src/public/protos/manager_analysis.proto",
            "components/manager-siteconfiguration/src/public/site-management.proto",
            "components/manager-siteconfiguration/src/public/alarm-subscriptions.proto",
            "components/manager-vppOps/src/public/vpp_ops.proto",
            "components/manager-feed/src/public/feed.proto",
            "components/manager-vppOps/src/resolver/types.ts",
            "libs/contracts/**",
            "libs/site-online/**",
            "libs/ra-workflow-client/**",
            "docs/vpp/design/ops-center-handoff/**"
          ]
        }
      },
      "jobs": [
        {
          "id": "owner-reading-contract",
          "name": "Owner reading wire contract",
          "uses": "./.github/workflows/_check.yml",
          "if": "github.event_name != 'pull_request' || github.event.pull_request.draft == false",
          "withName": "Owner reading wire contract",
          "pool": true
        },
        {
          "id": "ops-preview-contract",
          "name": "Ops preview wire contract",
          "uses": "./.github/workflows/_check.yml",
          "if": "github.event_name != 'pull_request' || github.event.pull_request.draft == false",
          "withName": "Ops preview wire contract",
          "pool": true
        },
        {
          "id": "prepare",
          "name": "Prepare",
          "if": "github.event_name != 'pull_request' || github.event.pull_request.draft == false"
        },
        {
          "id": "build-backend",
          "if": "${{ (github.event_name != 'pull_request' || github.event.pull_request.draft == false) && (!cancelled() && needs.prepare.result == 'success') }}"
        },
        {
          "id": "publish-backend",
          "if": "github.event_name != 'pull_request'"
        },
        {
          "id": "build-frontend",
          "if": "${{ (github.event_name != 'pull_request' || github.event.pull_request.draft == false) && (!cancelled() && needs.prepare.result == 'success') }}"
        },
        {
          "id": "deploy",
          "if": "github.event_name != 'pull_request'"
        },
        {
          "id": "deploy-frontend",
          "if": "github.event_name != 'pull_request'"
        },
        {
          "id": "integration-test",
          "name": "Integration Tests",
          "if": false
        },
        {
          "id": "designer-dev-smoke",
          "uses": "./.github/workflows/_designer-dev-smoke.yml",
          "if": "github.event_name != 'pull_request' && needs.prepare.outputs.tf_environment == 'dev'"
        }
      ]
    }
  ]
}
