server_name: "tinstar-engineering"
listen: "127.0.0.1:4222"

jetstream {
  store_dir: "/var/lib/tinstar-jetstream"
  # Closes the normal delayed-flush window. NATS 2.10.7 can acknowledge
  # a write after a sync I/O error. See jetstream.md for journal replay recovery.
  sync_interval: always
  max_file_store: 1GB
  max_memory_store: 64MB
}

accounts {
  TINSTAR {
    jetstream: enabled
    users: [
      {
        nkey: "ADMIN_PUBLIC_NKEY"
        permissions: {
          publish: ["$JS.API.>"]
          subscribe: ["_INBOX.tinstar_admin.>"]
        }
      }
      {
        nkey: "HULK_RELAY_PUBLIC_NKEY"
        permissions: {
          publish: ["tinstar.fact.jira.ticket.>"]
          subscribe: ["_INBOX.tinstar_relay.hulk-jira.>"]
        }
      }
    ]
  }
}
