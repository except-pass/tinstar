#!/usr/bin/env node
import { once } from 'node:events'
import { mkdtemp, readFile, realpath, rmdir } from 'node:fs/promises'
import { homedir, tmpdir } from 'node:os'
import { isAbsolute, join, resolve } from 'node:path'
import { createInterface } from 'node:readline'
import { setTimeout as sleep } from 'node:timers/promises'
import { parseArgs } from 'node:util'
import { deploymentSource, observeFloor } from './deployment.js'
import { observeHome, sourcesFor } from './firstmate.js'
import { githubInterval, githubObserver, githubSource } from './github.js'
import { Journal, JournalConfigurationError } from './journal.js'
import { jiraConfig, JiraWebhookConfigurationError, startJiraWebhook } from './jira.js'
import { migrationReceipt, MigrationReceiptError, routingReplayCheck } from './routing.js'

const usage = `Usage
  events serve --config <file> [--interval <seconds>]
  events observe --config <file>
  events watch [--after <sequence>] [filters] [--json]
  events replay [--last <count> | --after <sequence>] [filters] [--json]
  events inspect <event-id>
  events sources
  events record-migration <receipt.json>
  events routing-metrics-input < routing-observations.jsonl

Filters
  --source firstmate|jira|github|deployment|routing
  --type task|worker|ticket|pr|deployment|mate    --entity <entity-id>
All commands accept --db <path>. The default is ~/srv/event-publisher/journal.sqlite.
EVENTS_DB and EVENTS_CONFIG provide defaults for --db and --config.`

const options = {
  db: { type: 'string' },
  config: { type: 'string' },
  interval: { type: 'string' },
  after: { type: 'string' },
  last: { type: 'string' },
  source: { type: 'string' },
  type: { type: 'string' },
  entity: { type: 'string' },
  json: { type: 'boolean' },
  help: { type: 'boolean', short: 'h' },
}
const commandOptions = {
  serve: ['config', 'interval'],
  observe: ['config'],
  watch: ['after', 'source', 'type', 'entity', 'json'],
  replay: ['after', 'last', 'source', 'type', 'entity', 'json'],
  inspect: [],
  sources: [],
  'record-migration': [],
  'routing-metrics-input': [],
}
const pageSize = 200

class UsageError extends Error {}

function integer(value, flag, minimum) {
  if (!/^\d+$/.test(value) || !Number.isSafeInteger(Number(value)) || Number(value) < minimum) {
    throw new UsageError(`${flag} must be an integer of at least ${minimum}`)
  }
  return Number(value)
}

async function readConfig(path) {
  if (!path) throw new UsageError('set --config or EVENTS_CONFIG')
  let config
  try {
    config = JSON.parse(await readFile(path, 'utf8'))
  } catch {
    throw new UsageError('cannot read the configuration as JSON')
  }
  const jira = config?.jira === undefined ? null : jiraConfig(config.jira)
  const configuredHomes = config?.homes ?? []
  if (!Array.isArray(configuredHomes) || (!configuredHomes.length && !jira && config?.deployment !== true)) {
    throw new UsageError('configuration must contain at least one home, a Jira project or deployment: true')
  }
  for (const provider of ['github', 'deployment']) {
    if (config[provider] !== undefined && typeof config[provider] !== 'boolean') {
      throw new UsageError(`${provider} must be true or false`)
    }
  }
  const ids = new Set()
  const paths = new Set()
  const safeText = value => typeof value === 'string' && value.trim() === value && value.length > 0 &&
    !/[\u0000-\u001f\u007f]/u.test(value) && String.prototype.isWellFormed.call(value)
  const homes = []
  for (const home of configuredHomes) {
    if (!safeText(home?.id) || !safeText(home.path) || !isAbsolute(home.path) ||
        home.codeRoot !== undefined && (!safeText(home.codeRoot) || !isAbsolute(home.codeRoot)) ||
        home.mode !== undefined && !['live', 'fixture'].includes(home.mode) ||
        home.markdownFastPath !== undefined && typeof home.markdownFastPath !== 'boolean') {
      throw new UsageError('each home needs a stable id and absolute path; check codeRoot, mode and markdownFastPath if supplied')
    }
    const path = await realpath(home.path).catch(() => null)
    const configuredPath = home.path
    const uniquePath = path ?? resolve(configuredPath)
    if (ids.has(home.id) || paths.has(uniquePath)) throw new UsageError('home ids and paths must be unique')
    ids.add(home.id)
    paths.add(uniquePath)
    homes.push({ id: home.id, path, configuredPath, codeRoot: home.codeRoot && resolve(home.codeRoot), mode: home.mode ?? 'live',
      markdownFastPath: home.markdownFastPath ?? false })
  }
  const live = homes.some(home => home.mode === 'live')
  return { homes, jira, github: config.github ?? live, deployment: config.deployment ?? live }
}

function signalController() {
  const controller = new AbortController()
  const stop = () => controller.abort()
  process.on('SIGINT', stop)
  process.on('SIGTERM', stop)
  return {
    signal: controller.signal,
    abort: stop,
    close() {
      process.off('SIGINT', stop)
      process.off('SIGTERM', stop)
    },
  }
}

async function pause(ms, signal) {
  try {
    await sleep(ms, undefined, { signal })
  } catch (error) {
    if (error.name !== 'AbortError') throw error
  }
}

async function pollProvider(observe, journal, interval, controller) {
  do {
    const healthy = await observe(journal, controller.signal)
    if (!interval) return healthy
    await pause(interval * 1000, controller.signal)
  } while (!controller.signal.aborted)
}

async function collect(journal, { homes, jira, github, deployment }, interval, secret, readToken) {
  const controller = signalController()
  const providers = []
  const jobs = []
  let providerError
  let scratch, listener
  try {
    if (homes.length) scratch = await mkdtemp(join(tmpdir(), 'event-publisher-'))
    const sources = homes.flatMap(sourcesFor)
    if (jira) sources.push(jira.source)
    if (github) {
      sources.push(githubSource)
      providers.push([githubObserver(), githubInterval])
    }
    if (deployment) {
      sources.push(deploymentSource)
      providers.push([observeFloor, interval])
    }
    const taskCaches = new Map(homes.map(home => [home.id, {}]))
    journal.registerSources(sources, { reconcile: true })
    if (jira && interval) {
      listener = await startJiraWebhook(journal, jira, secret, readToken)
      console.error(`Jira webhook listening on ${listener.url}`)
    }
    if (interval && homes.length) console.error(`Observing ${homes.length} configured home(s) every ${interval} seconds`)
    let complete
    do {
      complete = true
      const start = performance.now()
      for (const home of homes) {
        if (home.path || controller.signal.aborted) continue
        home.unavailableReason = null
        const path = await realpath(home.configuredPath).catch(() => null)
        if (!path || homes.some(other => other.path === path)) continue
        try {
          journal.registerSources(sourcesFor({ ...home, path }))
          home.path = path
        } catch (error) {
          if (!(error instanceof JournalConfigurationError)) throw error
          home.unavailableReason = 'resolved FM_HOME conflicts with the journal binding'
        }
      }
      for (const home of homes) {
        if (controller.signal.aborted) break
        const observations = await observeHome(home, scratch, { taskCache: taskCaches.get(home.id) })
        if (!journal.recordAttempts(observations).every(result => result.complete)) complete = false
      }
      // The first forge pass uses accepted task links. Later network reads run
      // on their own cadence so timeouts never delay First Mate or block Jira.
      if (!jobs.length && !controller.signal.aborted) {
        for (const [observe, seconds] of providers) {
          jobs.push(pollProvider(observe, journal, interval ? seconds : null, controller).catch(error => {
            providerError ??= error
            controller.abort()
          }))
        }
      }
      // Always pause after a slow pass as well. Never overlap collector passes.
      if (interval) await pause(Math.max(1000 * interval - (performance.now() - start), 5000), controller.signal)
    } while (interval && !controller.signal.aborted)
    if (!interval) {
      const providerResults = await Promise.all(jobs)
      if (providerError) throw providerError
      return !controller.signal.aborted && complete && providerResults.every(Boolean)
    }
    if (providerError) throw providerError
  } finally {
    controller.abort()
    await Promise.all(jobs)
    await listener?.close()
    controller.close()
    if (scratch) await rmdir(scratch)
  }
}

function age(timestamp) {
  if (!timestamp) return 'never'
  const seconds = Math.max(0, Math.floor((Date.now() - Date.parse(timestamp)) / 1000))
  if (seconds < 60) return `${seconds}s`
  const minutes = Math.floor(seconds / 60)
  return minutes < 60 ? `${minutes}m` : `${Math.floor(minutes / 60)}h`
}

function healthText(source) {
  const counts = Object.entries(source.counts ?? {}).filter(([, count]) => count > 0)
    .map(([name, count]) => `${name}=${count}`)
  const reason = source.reason ? ` · ${source.reason}` : ''
  const coverage = counts.length ? ` · ${counts.join(', ')}` : ''
  return `${source.source_id}${source.mode ? ` [${source.mode}]` : ''} ${source.health} · ${source.coverage}${reason}${coverage}`
}

function publishedSources(journal) {
  const sources = journal.sources()
  const defaults = [
    { source_id: 'firstmate:task', type: 'task', coverage: 'configured active backlogs' },
    { source_id: 'firstmate:worker', type: 'worker', coverage: 'configured local worker incarnations' },
    { source_id: 'jira:ticket', type: 'ticket', coverage: 'signed project webhooks' },
    githubSource, deploymentSource,
  ]
  for (const source of defaults) {
    if (!sources.some(current => current.type === source.type)) {
      sources.push({ ...source, mode: null, health: 'unconnected', reason: 'observer is not configured' })
    }
  }
  return sources
}

function valueText(value) {
  if (value === null) return '—'
  if (Array.isArray(value)) return value.length ? value.map(item => item.id ? `${item.type} ${item.id}` : item).join(', ') : '—'
  return String(value)
}

function jiraEventLabel(event) {
  const { change, evidence, event_type: type } = event
  const printable = value => value === undefined ? 'unknown' : valueText(value).replace(/\n/g, ' ↵ ')
  if (type === 'ticket.created') {
    const values = [change.after.status, change.after.summary].filter(Boolean).map(printable)
    return ['created', ...values].join(' · ')
  }
  if (type === 'ticket.comment.created') {
    return [`comment ${evidence.source_reference.comment_id} created`, change.after == null ? '' : printable(change.after)].filter(Boolean).join(' · ')
  }
  return `${change.field} ${printable(change.before)} → ${printable(change.after)}`
}

function eventText(event, replay, health) {
  const time = new Date(event.observed_at).toLocaleTimeString()
  const { source, subject, change, evidence } = event
  const reference = evidence.source_reference
  if (source.provider === 'jira') {
    const omissions = event.observation?.projection_omissions
    const projection = omissions?.length ? ` · partial projection (${omissions.join(', ')})` : ''
    return `${time} ${replay ? '[replay] ' : ''}jira/ticket ${reference.issue_key} · ${jiraEventLabel(event)}${projection} · ${age(event.observed_at)} ago · ${health ?? 'unknown'} · #${event.sequence} ${event.event_id}`
  }
  if (source.provider === 'routing') {
    const context = route => `${route.machine}/${route.runtime}/${route.provider}`
    const labels = [replay && 'replay', source.mode === 'fixture' && 'controlled proof'].filter(Boolean)
    const prefix = labels.length ? `[${labels.join('/')}] ` : ''
    return `${time} ${prefix}routing/mate ${subject.id} · ${context(change.before)} → ${context(change.after)} · effective ${event.effective_start_at} · #${event.sequence} ${event.event_id}`
  }
  if (source.provider === 'github' || source.provider === 'deployment') {
    const labels = [replay && 'replay', source.mode].filter(Boolean)
    const compact = source.provider === 'github' ? `${reference.repository}#${reference.number}` : reference.target
    const category = source.provider === 'github' ? 'github/pr' : 'floor/deployment'
    const render = value => {
      if (change.field === 'checks') {
        const groups = Object.groupBy(value, run => run.conclusion ?? run.status)
        return Object.keys(groups).sort().map(result => `${result}=${groups[result].length}`).join(', ') || 'no checks'
      }
      if (change.field?.endsWith('sha') || change.field === 'revision') return value?.slice(0, 12) ?? '—'
      return change.field ? valueText(value) : value.state ?? `${value.lifecycle} ${value.revision.slice(0, 12)}`
    }
    const meaning = [event.event_type, change.field, Object.hasOwn(change, 'before')
      ? `${render(change.before)} → ${render(change.after)}` : render(change.after)].filter(Boolean).join(' · ')
    return `${time} [${labels.join('/')}] ${category} ${compact} · ${meaning} · ${age(event.observed_at)} ago · ${health ?? 'unknown'} · #${event.sequence} ${event.event_id}`
  }
  const compact = [reference.task_id, reference.spawn_gen].filter(Boolean).join('@')
  let meaning = change.field
    ? Object.hasOwn(change, 'before')
      ? `${change.field} ${valueText(change.before)} → ${valueText(change.after)}`
      : `first observed · ${change.field} ${valueText(change.after)}`
    : `first observed · ${change.after.state ?? change.after.current_state}`
  if (event.event_type === 'worker.inventory.left') meaning = 'no longer in the accepted inventory'
  if (event.event_type === 'worker.inventory.entered') meaning = 'returned to the accepted inventory'
  if (event.event_type === 'worker.observed' && change.after.reason) meaning += ` (${change.after.reason})`
  return `${time} [${replay ? 'replay/' : ''}${source.mode}] firstmate/${subject.type} ${source.home_id}/${compact} · ${meaning} · ${age(event.observed_at)} ago · ${health ?? 'unknown'} · #${event.sequence} ${event.event_id}`
}

async function showThrough(journal, cursor, through, filters, json, replay, statuses, signal) {
  while (cursor < through && !signal?.aborted) {
    const rows = journal.events({ after: cursor, through, limit: pageSize, ...filters })
    for (const event of rows) {
      if (signal?.aborted) return cursor
      const line = json ? JSON.stringify(event) : eventText(event, replay, statuses.get(event.source.source_id)?.health)
      if (!process.stdout.write(line + '\n')) await once(process.stdout, 'drain', { signal })
      cursor = event.sequence
    }
    if (rows.length < pageSize) break
  }
  return Math.max(cursor, through)
}

async function watch(journal, after, filters, json) {
  const controller = signalController()
  const attach = journal.tail()
  let cursor = after ?? attach
  const signatures = new Map()
  console.error(`Watching from sequence ${cursor}${after !== undefined ? ` (replay through ${attach})` : ''}`)
  try {
    while (!controller.signal.aborted) {
      const statuses = new Map(publishedSources(journal).filter(source =>
        (!filters.type || filters.type === source.type) &&
        (!filters.provider || source.source_id.startsWith(`${filters.provider}:`)))
        .map(source => [source.source_id, source]))
      for (const [id, source] of statuses) {
        const summary = healthText(source)
        if (signatures.get(id) !== summary) {
          console.error(summary)
          signatures.set(id, summary)
        }
      }
      cursor = await showThrough(journal, cursor, attach, filters, json, true, statuses, controller.signal)
      cursor = await showThrough(journal, cursor, journal.tail(), filters, json, false, statuses, controller.signal)
      await pause(1000, controller.signal)
    }
  } catch (error) {
    if (!controller.signal.aborted || error.name !== 'AbortError') throw error
  } finally {
    controller.close()
  }
}

async function readMigration(path) {
  let input
  try {
    input = JSON.parse(await readFile(path, 'utf8'))
  } catch {
    throw new UsageError('cannot read the migration receipt as JSON')
  }
  return migrationReceipt(input, new Date().toISOString())
}

async function routingMetricsInput(journal) {
  const replayWarning = routingReplayCheck(journal.migrationReceipts())
  const lines = createInterface({ input: process.stdin, crlfDelay: Infinity })
  let lineNumber = 0
  let skippedRows = 0
  for await (const line of lines) {
    lineNumber++
    if (!line.trim()) continue
    let row
    try {
      row = JSON.parse(line)
    } catch {
      console.error(JSON.stringify({ warning: 'routing.invalid_json', line: lineNumber, skipped_rows: ++skippedRows }))
      continue
    }
    const warning = replayWarning(row)
    if (warning) console.error(JSON.stringify(warning))
    else if (!process.stdout.write(line + '\n')) await once(process.stdout, 'drain')
  }
}

async function main() {
  let args
  try {
    args = parseArgs({ options, allowPositionals: true })
  } catch (error) {
    throw new UsageError(error.message)
  }
  const { values, positionals: [command, detail, ...extra] } = args
  if (!command || values.help) {
    console.log(usage)
    return
  }
  if (!Object.hasOwn(commandOptions, command) || extra.length ||
      ['inspect', 'record-migration'].includes(command) !== Boolean(detail)) {
    throw new UsageError('invalid command or arguments')
  }
  for (const key of Object.keys(values)) {
    if (key !== 'db' && !commandOptions[command].includes(key)) {
      throw new UsageError(`--${key} is unsupported for ${command}`)
    }
  }
  if (values.type !== undefined && !['task', 'worker', 'ticket', 'pr', 'deployment', 'mate'].includes(values.type)) throw new UsageError('--type must be task, worker, ticket, pr, deployment or mate')
  if (values.after !== undefined && values.last !== undefined) throw new UsageError('choose --after or --last')
  const after = values.after === undefined ? undefined : integer(values.after, '--after', 0)
  const last = integer(values.last ?? '100', '--last', 1)
  if (values.source !== undefined && !['firstmate', 'jira', 'github', 'deployment', 'routing'].includes(values.source)) throw new UsageError('--source must be firstmate, jira, github, deployment or routing')
  const filters = { type: values.type, entity: values.entity, provider: values.source }
  const defaultPath = join(homedir(), 'srv/event-publisher/journal.sqlite')
  const configuredPath = resolve(process.env.EVENTS_DB ?? defaultPath)
  const path = resolve(values.db ?? configuredPath)
  const collector = command === 'serve' || command === 'observe'
  const interval = command === 'serve' ? integer(values.interval ?? '20', '--interval', 15) : null
  if (interval > 3600) throw new UsageError('--interval must be at most 3600 seconds')
  const config = collector ? await readConfig(values.config ?? process.env.EVENTS_CONFIG) : null
  const migration = command === 'record-migration' ? await readMigration(detail) : null
  if (migration?.source.mode === 'fixture' && (!values.db || path === configuredPath || path === defaultPath)) {
    throw new UsageError('controlled receipts require --db pointing to a separate journal')
  }
  const secret = process.env.EVENTS_JIRA_WEBHOOK_SECRET
  const readToken = process.env.EVENTS_JIRA_READ_TOKEN
  // First Mate polling starts subprocesses. Keep Jira credentials in this process.
  delete process.env.EVENTS_JIRA_WEBHOOK_SECRET
  delete process.env.EVENTS_JIRA_READ_TOKEN
  if (config?.jira && command === 'serve' && !secret?.trim()) {
    throw new UsageError('set EVENTS_JIRA_WEBHOOK_SECRET from the Jira admin webhook secret')
  }
  if (command === 'observe' && !config.homes.length && !config.deployment) throw new UsageError('use events serve to receive Jira webhooks')
  const journal = new Journal(path, { readOnly: !collector && !migration })
  try {
    if (collector) {
      const healthy = await collect(journal, config, interval, secret, readToken)
      if (command === 'observe' && !healthy) process.exitCode = 1
    } else if (migration) {
      console.log(JSON.stringify(journal.recordMigration(migration)))
    } else if (command === 'routing-metrics-input') {
      await routingMetricsInput(journal)
    } else if (command === 'watch') {
      await watch(journal, after, filters, values.json)
    } else if (command === 'inspect') {
      const event = journal.inspect(detail)
      if (!event) throw new UsageError('event id not found')
      console.log(JSON.stringify(event, null, 2))
    } else if (command === 'sources') {
      for (const source of publishedSources(journal)) {
        const last = source.provider === 'jira' ? 'last signed delivery' : source.provider === 'routing'
          ? 'last recorded migration' : ['github', 'deployment'].includes(source.provider)
            ? 'last accepted observation' : 'last accepted inventory'
        console.log(`${healthText(source)} · last attempt ${age(source.last_attempt_at)} · ${last} ${age(source.last_success_at)}`)
      }
    } else {
      const statuses = new Map(journal.sources().map(source => [source.source_id, source]))
      if (values.json) console.error('Replay from the journal')
      const through = journal.tail()
      const cursor = after ?? journal.cursorBeforeLast(through, last, filters)
      await showThrough(journal, cursor, through, filters, values.json, true, statuses)
    }
  } finally {
    journal.close()
  }
  if (command === 'watch') process.exit(0)
}

process.umask(0o077)
process.stdout.on('error', error => {
  if (error.code === 'EPIPE') process.exit(0)
  throw error
})

try {
  await main()
} catch (error) {
  const usageError = error instanceof UsageError || error instanceof MigrationReceiptError
  const message = usageError || error instanceof JournalConfigurationError || error instanceof JiraWebhookConfigurationError ? error.message
    : error.code === 'ERR_SQLITE_ERROR' ? 'cannot access the journal; check its path, permissions and writer'
    : 'publisher failed; check the journal path and permissions'
  console.error(`events: ${message}`)
  process.exitCode = usageError ? 2 : 1
}
